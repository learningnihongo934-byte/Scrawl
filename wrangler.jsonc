{
  // Scrawl: static game (public/) + duel-room Durable Object. ./build.sh deploy
  "name": "scrawl",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // scrawl.rennko.tech/* is more specific than Rennko Cloud's *.rennko.tech/* route, so this host stays here
  "routes": [{ "pattern": "scrawl.rennko.tech", "custom_domain": true }, { "pattern": "scrawl.rennko.tech/*", "zone_name": "rennko.tech" }],
  "workers_dev": true
}
